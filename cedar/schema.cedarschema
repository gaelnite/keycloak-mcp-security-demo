// Cedar schema for the Keycloak MCP server.
//
// The PEP supplies the caller realm, write enablement and human approval facts.
// Policies never parse Keycloak URLs or tool arguments for security decisions.

namespace KeycloakMCP {

  entity Realm;

  // A human caller (interactive or token-exchange subject).
  entity User in [Realm] = {
    "subject": String,
    "issuer"?: String,
    "clientId"?: String,
    "scopes": Set<String>,
    "roles": Set<String>,
  };

  // An MCP client/agent identified by its Keycloak client (CIMD URL or client id).
  entity Client in [Realm] = {
    "clientId": String,
    "scopes": Set<String>,
    "roles": Set<String>,
  };

  entity Tool = {
    "name": String,
    "requiredScope": String,
    "tier": String,
    "write": Bool,
  };

  entity Resource = {
    "kind": String,
    "realm": Realm,
  };

  type AuthzContext = {
    "resource": Resource,
    "toolKnown": Bool,
    "writesEnabled": Bool,
    "approvalVerified": Bool,
    "approvalTool": String,
  };

  action "Read" appliesTo {
    principal: [User, Client],
    resource: [Tool],
    context: AuthzContext
  };

  action "Write" appliesTo {
    principal: [User, Client],
    resource: [Tool],
    context: AuthzContext
  };

}
