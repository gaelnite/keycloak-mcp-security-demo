{
  "mcpServers": {
    "keycloak-mcp-stdio": {
      "command": "/path/to/keycloak-mcp/.venv/bin/python",
      "args": [
        "/path/to/keycloak-mcp/mcp/server.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "SSL_CERT_FILE": "/path/to/demo-ca.pem",
        "KC_URL": "https://localhost:49443",
        "KC_ISSUER": "https://localhost:49443/realms/lab",
        "KC_AUDIENCE": "https://localhost:49443/mcp",
        "KC_MCP_RESOURCE_URL": "https://localhost:49443/mcp",
        "KC_ALLOWED_CLIENT_IDS": "mcp-workload",
        "KC_MCP_ACCESS_TOKEN_FILE": "/home/you/.config/keycloak-mcp/access-token",
        "KC_MCP_ENABLE_WRITES": "0",
        "KC_MCP_AUDIT_LOG": "/home/you/.local/state/keycloak-mcp/authz-audit.jsonl",
        "KC_MCP_TOOL_ALLOWLIST": "get_extension_inventory"
      }
    },
    "keycloak-mcp-http": {
      "url": "https://localhost:49443/mcp",
      "headers": {
        "Authorization": "Bearer ${KC_MCP_ACCESS_TOKEN}"
      }
    }
  }
}
