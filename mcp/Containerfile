# MCP reference server: Python server + Cedar PDP (Node), for rootless Podman.
# Build context = repo root (from the repo root):
#   podman build -t localhost/keycloak-mcp:0.1.0-lab03 -f mcp/Containerfile .
# The Cedar PDP (mcp/pdp.mjs) runs as a Node subprocess of the server; both
# runtimes live in this one image. The default runtime uses the same digest as the Compose demo.
ARG NODE_IMAGE=docker.io/library/node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
FROM ${NODE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layers first so code edits do not invalidate them.
COPY mcp/requirements.txt mcp/package.json mcp/package-lock.json ./mcp/
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r mcp/requirements.txt \
    && npm ci --prefix mcp --omit=dev

COPY mcp/*.py mcp/*.mjs ./mcp/
COPY cedar/policies.cedar cedar/schema.cedarschema cedar/entities.json ./cedar/
# Source files in the checkout can be mode 0600; make the app tree readable
# for the container USER.
RUN chmod -R a+rX /app

USER node
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1
EXPOSE 8800
# The server listens on loopback. Docker Compose puts MCP and the TLS edge
# in the same network namespace and defines the service health check.
CMD ["python", "mcp/server.py", "--transport", "http", "--host", "127.0.0.1", "--port", "8800"]
